#include<stdio.h>
int sumofdigits(int n)
{
    int sum=0;
    int digit;

    while(n>0)
    {
        digit=n%10;
        sum= sum+digit;
        n=n/10;
    }
    return sum;
}
int main(void)
{
    int number,result;

    printf("Enter the number ");
    scanf("%d",&number);

    result=sumofdigits(number);

    printf("sum of digits is =%d",result);

    return 0;
}
