#include<stdio.h>
int factorial(int n)
{
    int fact=1;
    for(int i=1;i<=n;i++)
    {
        fact=fact*i;

    }
    return fact;

}
int main(void)
{
    int num,result;

    printf("Enter the number");
    scanf("%d",&num);

    result=factorial(num);
    printf("the factorial of entered number is %d",result);

    return 0;
}
